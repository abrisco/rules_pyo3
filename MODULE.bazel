"""abrisco/rules_pyo3"""

module(
    name = "rules_pyo3",
    version = "0.0.10",
)

bazel_dep(name = "rules_rust", version = "0.64.0")
bazel_dep(name = "rules_python", version = "1.5.3")
bazel_dep(name = "bazel_skylib", version = "1.8.1")
bazel_dep(name = "platforms", version = "1.0.0")

rust_ext = use_extension("//pyo3:extensions.bzl", "rust_ext")
use_repo(
    rust_ext,
    "rpyo3c",
    "rpyo3c__pyo3-0.26.0",
    "rpyo3c__pyo3-ffi-0.26.0",
    "rpyo3c__pyo3-introspection-0.26.0",
)

register_toolchains(
    "//pyo3/toolchains:toolchain",
    "//pyo3/toolchains:rust_toolchain",
    dev_dependency = True,
)

bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True, repo_name = "io_bazel_stardoc")
bazel_dep(name = "rules_rust_mdbook", version = "0.64.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.6.0", dev_dependency = True)
